// Zed Terminal keymap
[
  {
    "bindings": {
      "ctrl-shift-t": "zed_terminal::NewTerminalTab",
      "ctrl-shift-w": "pane::CloseActiveItem",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "f1": "command_palette::Toggle",
      "ctrl-shift-p": "command_palette::Toggle",
      "ctrl-alt-1": ["pane::ActivateItem", 0],
      "ctrl-alt-2": ["pane::ActivateItem", 1],
      "ctrl-alt-3": ["pane::ActivateItem", 2],
      "ctrl-alt-4": ["pane::ActivateItem", 3],
      "ctrl-alt-5": ["pane::ActivateItem", 4],
      "ctrl-alt-6": ["pane::ActivateItem", 5],
      "ctrl-alt-7": ["pane::ActivateItem", 6],
      "ctrl-alt-8": ["pane::ActivateItem", 7],
      "ctrl-=": ["zed::IncreaseBufferFontSize", { "persist": false }],
      "ctrl-shift-=": ["zed::IncreaseBufferFontSize", { "persist": false }],
      "ctrl--": ["zed::DecreaseBufferFontSize", { "persist": false }],
      "ctrl-0": ["zed::ResetBufferFontSize", { "persist": false }],
      "ctrl-shift-5": "pane::SplitRight",
      "alt-shift-d": "pane::SplitRight",
      "alt-shift-plus": "pane::SplitDown",
      "alt-shift-minus": "pane::SplitDown",
      "shift-escape": "workspace::ToggleZoom",
      "ctrl-,": "zed::OpenSettingsFile",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-alt-space": "terminal::ShowCharacterPalette",
      "ctrl-insert": "terminal::Copy",
      "ctrl-shift-c": "terminal::Copy",
      "shift-insert": "terminal::Paste",
      "ctrl-shift-v": "terminal::Paste",
      "ctrl-alt-v": "terminal::PasteText",
      "ctrl-shift-a": "editor::SelectAll",
      "ctrl-shift-f": "buffer_search::Deploy",
      "ctrl-shift-l": "terminal::Clear",
      "shift-pageup": "terminal::ScrollPageUp",
      "shift-pagedown": "terminal::ScrollPageDown",
      "shift-up": "terminal::ScrollLineUp",
      "shift-down": "terminal::ScrollLineDown",
      "shift-home": "terminal::ScrollToTop",
      "shift-end": "terminal::ScrollToBottom",
      "ctrl-shift-pageup": "terminal::ScrollPageUp",
      "ctrl-shift-pagedown": "terminal::ScrollPageDown",
      "ctrl-shift-up": "terminal::ScrollLineUp",
      "ctrl-shift-down": "terminal::ScrollLineDown",
      "ctrl-shift-home": "terminal::ScrollToTop",
      "ctrl-shift-end": "terminal::ScrollToBottom",
      "ctrl-shift-space": "terminal::ToggleViMode",
      "ctrl-shift-r": "terminal::RerunTask",
      "ctrl-alt-r": "terminal::RerunTask",
      "alt-t": "terminal::RerunTask",
    },
  },
  {
    "context": "os == windows && Terminal",
    "bindings": {
      "alt-left": "workspace::ActivatePaneLeft",
      "alt-right": "workspace::ActivatePaneRight",
      "alt-up": "workspace::ActivatePaneUp",
      "alt-down": "workspace::ActivatePaneDown",
      "alt-shift-left": "zed_terminal::ResizePaneLeft",
      "alt-shift-right": "zed_terminal::ResizePaneRight",
      "alt-shift-up": "zed_terminal::ResizePaneUp",
      "alt-shift-down": "zed_terminal::ResizePaneDown",
      "ctrl-v": "terminal::Paste",
    },
  },
  {
    "context": "os == macos && Terminal",
    "bindings": {
      "cmd-c": "terminal::Copy",
      "cmd-v": "terminal::Paste",
      "ctrl-cmd-v": "terminal::PasteText",
      "cmd-k": "terminal::Clear",
      "cmd-up": "terminal::ScrollPageUp",
      "cmd-down": "terminal::ScrollPageDown",
      "cmd-home": "terminal::ScrollToTop",
      "cmd-end": "terminal::ScrollToBottom",
    },
  },
  {
    "context": "Terminal && selection",
    "bindings": {
      "ctrl-c": "terminal::Copy",
    },
  },
]
